{
    "manifest_version": 3,
    "default_locale": "de",
    "name": "NEXTBookmarks",
    "version": "0.1.0",
    "description": "__MSG_extDescription__",
    "permissions": ["bookmarks", "storage", "alarms"],
    "optional_host_permissions": ["https://*/*", "http://localhost/*"],
    "background": {
        "service_worker": "background.js",
        "scripts": ["browser-polyfill-shim.js", "background.js"]
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "NEXTBookmarks",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "options.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "nextbookmarks@example.com"
        }
    }
}
