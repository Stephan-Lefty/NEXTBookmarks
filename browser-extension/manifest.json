{
    "manifest_version": 3,
    "name": "NEXTBookmarks",
    "version": "0.1.0",
    "description": "Synchronisiert deine Browser-Lesezeichen mit deiner Nextcloud.",
    "permissions": ["bookmarks", "storage", "alarms"],
    "host_permissions": ["https://*/*", "http://localhost/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "NEXTBookmarks",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "options.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "nextbookmarks@example.com"
        }
    }
}
